{
  "name": "nox-functions",
  "version": "0.1.0",
  "private": true,
  "description": "NOX trusted backend functions",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test lib-test/test/inviteToken.test.js lib-test/test/discordMessages.test.js lib-test/test/adminStoreCreate.test.js lib-test/test/adminDate.test.js lib-test/test/adminStoreMedia.test.js lib-test/test/adminStoreMediaUi.test.js lib-test/test/publicJobStoreMedia.test.js lib-test/test/jobDetailMedia.test.js lib-test/test/jobCardMedia.test.js lib-test/test/storeCoverCache.test.js lib-test/test/phoneIdentity.test.js lib-test/test/phoneVerificationUi.test.js lib-test/test/operatorTestPlay.test.js lib-test/test/coin.test.js lib-test/test/coinTransactions.test.js",
    "test:integration": "npm run build:test && node --test lib-test/test/*.integration.test.js",
    "test:integration:invite-preview": "npm run build:test && node --test lib-test/test/getStoreInvitePreview.integration.test.js",
    "test:integration:admin-auth": "npm run build:test && node --test --test-concurrency=1 lib-test/test/approveStoreApplicationAndIssueInvite.integration.test.js lib-test/test/firestoreAdminAuthorization.rules.integration.test.js",
    "test:rules:admin": "npm run build:test && node --test lib-test/test/firestoreAdminAuthorization.rules.integration.test.js",
    "test:rules:pricing-contracts": "npm run build:test && node --test --test-concurrency=1 lib-test/test/firestorePricingContracts.rules.integration.test.js",
    "test:rules:jobs-applications": "npm run build:test && node --test --test-concurrency=1 lib-test/test/firestoreJobsApplications.rules.integration.test.js",
    "test:rules:storage-job-images": "npm run build:test && node --test --test-concurrency=1 lib-test/test/storageJobImages.rules.integration.test.js",
    "test:rules:phone-identity": "npm run build:test && node --test --test-concurrency=1 lib-test/test/firestorePhoneIdentity.rules.integration.test.js",
    "test:rules:phase2": "npm run build:test && node --test --test-concurrency=1 lib-test/test/firestoreJobsApplications.rules.integration.test.js lib-test/test/storageJobImages.rules.integration.test.js lib-test/test/firestorePricingContracts.rules.integration.test.js lib-test/test/firestoreAdminAuthorization.rules.integration.test.js",
    "test:integration:discord": "npm run build:test && node --test --test-concurrency=1 lib-test/test/discordNotifier.integration.test.js",
    "test:integration:store-contract": "npm run build:test && node --test --test-concurrency=1 lib-test/test/updateStoreContract.integration.test.js",
    "test:integration:approve-job": "npm run build:test && node --test --test-concurrency=1 lib-test/test/approveJobApplication.integration.test.js",
    "test:integration:coin": "npm run build:test && node --test --test-concurrency=1 lib-test/test/coinTransactions.integration.test.js",
    "test:emulator:store-publication": "node --test --test-concurrency=1 lib-test/test/updateStoreContract.integration.test.js lib-test/test/firestoreJobsApplications.rules.integration.test.js lib-test/test/storageJobImages.rules.integration.test.js lib-test/test/firestorePricingContracts.rules.integration.test.js lib-test/test/firestoreAdminAuthorization.rules.integration.test.js",
    "emulators": "firebase emulators:start --config ../firebase.json --project demo-nox-local --only auth,firestore,functions"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "firebase-tools": "15.24.0",
    "typescript": "5.9.3"
  }
}
